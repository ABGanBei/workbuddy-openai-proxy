# ============ workbuddy-openai-proxy 配置 ============
# 复制本文件为 .env 后按需修改。所有配置均有默认值,不配置也能运行。

# 代理监听端口
PORT=3000

# 代理监听地址(本地工具默认只监听回环,不暴露到局域网;
# 如需被局域网内其他设备访问,改为 0.0.0.0,并自行做好访问控制)
HOST=127.0.0.1

# 【可选】直接指定 WorkBuddy access token。
# 设置后代理不再读取本机 WorkBuddy 桌面 App 的登录文件。
# 适用于"把凭据搬运到无桌面环境的服务器"场景。
WORKBUDDY_TOKEN=

# 【可选】与 WORKBUDDY_TOKEN 搭配:该 token 所属的登录域
# 国内版通常为 www.codebuddy.cn / www.workbuddy.cn
# 国际版为 www.workbuddy.ai(或 www.codebuddy.ai)
# 留空时默认按国内版(www.codebuddy.cn)处理
WORKBUDDY_DOMAIN=

# 兜底模型列表(逗号分隔)。
# 只有当从 WorkBuddy 上游拉取模型目录失败时才会用到;
# 目录拉取成功时以真实目录为准。
DEFAULT_MODEL=workbuddy-model

# 上游响应超时(毫秒)。只约束"等到上游开始响应"的时间,
# 流式输出过程中不受此限制。
TIMEOUT=120000

# 上游请求失败后的自动重试间隔(毫秒)。每个请求最多自动重试 1 次。
RETRY_DELAY_MS=1000

# 模型目录缓存时间(毫秒)
MODEL_CACHE_TTL_MS=600000

# 【可选】手动指定 WorkBuddy 凭据文件路径(默认自动探测
# 桌面 App 的 auth 目录)。
WORKBUDDY_AUTH_FILE=

# 【可选】手动指定 WorkBuddy 桌面 App 可执行文件。
# 凭据被加密(WorkBuddy 5.6+ 默认)时,代理需要借助 App 解密;
# App 装在非默认位置时用此变量指向它。
WORKBUDDY_APP_EXECUTABLE=

# 日志级别: debug | info | warn | error
LOG_LEVEL=info
